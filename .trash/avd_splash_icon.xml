<?xml version="1.0" encoding="utf-8"?>
<!-- Ring draws in first (trimPathEnd 0->1), then the center dot fades in once
     the ring finishes (startOffset = the ring's own duration) — a sequence,
     not two things animating at once. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vd_splash_icon">
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="600"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="200"
                android:startOffset="600" />
        </aapt:attr>
    </target>
</animated-vector>
