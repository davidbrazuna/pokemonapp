<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PokemonApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App always renders on light surfaces, so pin dark status-bar icons
             here too. enableEdgeToEdge() sets this in code, but the Material
             DayNight parent otherwise re-derives it from the system theme when
             it's applied via postSplashScreenTheme after the splash. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PokemonApp" parent="Base.Theme.PokemonApp" />

    <!-- Shown while the app cold-starts, before Theme.PokemonApp takes over
         (postSplashScreenTheme below handles that switch automatically). -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_inset</item>
        <item name="postSplashScreenTheme">@style/Theme.PokemonApp</item>
    </style>
</resources>